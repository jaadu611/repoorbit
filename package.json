{
  "name": "repoorbit",
  "displayName": "RepoOrbit",
  "description": "Run self-healing query pipelines and review diffs inside your local workspace.",
  "version": "0.1.0",
  "publisher": "JAADU611",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaadu611/repoorbit.git"
  },
  "main": "./dist-extension/extension_v4_final.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "repoorbit.openWorkspace",
        "title": "Open RepoOrbit Workspace",
        "category": "RepoOrbit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repoorbit-sidebar-container",
          "title": "RepoOrbit",
          "icon": "logo.png"
        }
      ]
    },
    "views": {
      "repoorbit-sidebar-container": [
        {
          "type": "webview",
          "id": "repoorbit.sidebarView",
          "name": "RepoOrbit"
        }
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "ext:build-ui": "vite build",
    "ext:build-host": "esbuild src/extension.ts --bundle --outfile=dist-extension/extension_v4_final.js --external:vscode --platform=node",
    "ext:package": "npm run ext:build-ui && npm run ext:build-host"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "lucide-react": "^0.575.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@tailwindcss/vite": "^4",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^6.1.1"
  }
}
